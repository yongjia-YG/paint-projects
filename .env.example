# 複製這個檔成 .env，填入實際值。.env 不會進 git。

# MySQL 連線字串（TiDB Serverless / Aiven 提供）
# TiDB 範例：mysql://USER:PASSWORD@HOST:4000/DBNAME?sslaccept=strict
DATABASE_URL="mysql://user:password@localhost:3306/yongjia"

# 加密 Cookie session 的密鑰（至少 32 字元）
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD="請換成至少32字元的隨機字串please-change-me"

# Cloudinary（Phase 4 圖片上傳才會用到）
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
